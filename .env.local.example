# Copy this file to ".env.local" and fill in the two values from your Supabase dashboard.
# .env.local is git-ignored, so your real values never get committed.
#
# Where to find these: Supabase dashboard > your project > Project Settings > API (or "API Keys").

# The "Project URL" (looks like https://abcdefgh.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# The public "anon" / "publishable" key (a long string; safe to expose in the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# SERVER-ONLY SECRETS (added in Stage 3). These must NEVER start with
# NEXT_PUBLIC and must NEVER be shared or committed. They are only ever read by
# the server, never sent to the browser.
# ---------------------------------------------------------------------------

# The Supabase "service_role" secret key. Same dashboard page as above
# (Project Settings > API), under "service_role". It bypasses Row Level
# Security, so the server uses it to write session rows. Keep it secret.
SUPABASE_SERVICE_ROLE_KEY=

# Your OpenAI API key (starts with "sk-"). From platform.openai.com > API keys.
# Used server-side to run the Alex conversation and the rubric scoring.
OPENAI_API_KEY=

# Optional: which OpenAI model to use. Defaults to gpt-4o if left blank.
OPENAI_MODEL=
