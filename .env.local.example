# Copy this file to ".env.local" and fill in the two values from your Supabase dashboard.
# .env.local is git-ignored, so your real values never get committed.
#
# Where to find these: Supabase dashboard > your project > Project Settings > API (or "API Keys").

# The "Project URL" (looks like https://abcdefgh.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# The public "anon" / "publishable" key (a long string; safe to expose in the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
